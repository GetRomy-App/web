# Contact + waitlist forms (src/routes/api/contact, src/routes/api/waitlist) —
# both send mail via Resend (https://resend.com).

# Required: Resend API key. Without it, both forms return a friendly error.
RESEND_API_KEY=

# Optional: the From address. MUST be a Resend-verified sender/domain.
# Defaults to "Rōmy <noreply@letters.getromy.app>".
# CONTACT_FROM_EMAIL="Rōmy <noreply@letters.getromy.app>"

# Optional: comma-separated recipients for the contact / issue form.
# Defaults to solomon@getromy.app,howard@getromy.app
# CONTACT_TO_EMAILS="solomon@getromy.app,howard@getromy.app"

# Optional: comma-separated recipients for waitlist signups.
# Defaults to solomon@getromy.app,howard@getromy.app
# WAITLIST_TO_EMAILS="solomon@getromy.app,howard@getromy.app"

# Optional: Resend audience id. When set, every waitlist signup is also added
# to that audience, so the list lives somewhere you can mail later — not just
# in the inbox. Create one at https://resend.com/audiences and paste its id.
# Without it, signups still email the team; they just aren't stored.
# RESEND_AUDIENCE_ID=
