# Contact form (src/routes/api/contact) — sends mail via Resend (https://resend.com).

# Required: Resend API key. Without it, the contact form returns a friendly error.
RESEND_API_KEY=

# Optional: the From address. MUST be a Resend-verified sender/domain.
# Defaults to "Rōmy <noreply@getromy.app>".
# CONTACT_FROM_EMAIL="Rōmy <noreply@getromy.app>"

# Optional: comma-separated recipients.
# Defaults to solomon@getromy.app,howard@getromy.app
# CONTACT_TO_EMAILS="solomon@getromy.app,howard@getromy.app"
